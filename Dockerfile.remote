FROM zyh2333/horsecoder-maven:1.0.4
#作者
MAINTAINER zhuyuhan2333 <zhuyuhan2333@horsecoder.com>
#系统编码
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN mkdir -p /usr/local/build
COPY ./ /usr/local/build
WORKDIR /usr/local/build
RUN mvn clean package
#应用构建成功后的jar文件被复制到镜像内
RUN mv core-starter/target/core-starter-1.0.0-executable.jar /usr/local/core-1.0.0.jar \
   && rm -rf /usr/local/build
#运行容器后执行的第一条命令
ENTRYPOINT ["java","-jar","-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=33479","/usr/local/core-1.0.0.jar","--spring.profiles.active=remote"]
#暴露端口
EXPOSE 33477
EXPOSE 33479